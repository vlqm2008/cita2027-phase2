{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Master Pipeline (End-to-End)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_all_phases.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
            }
        },
        {
            "name": "Python: Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
            }
        },
        {
            "name": "Python: Run Hypothesis H3 Unified Benchmark",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_hypothesis_h3.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
            }
        },
        {
            "name": "Python: Run Statistical Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_statistical_tests.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
            }
        }
    ]
}
