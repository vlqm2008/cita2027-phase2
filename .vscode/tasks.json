{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Hypothesis H1 Evaluation (Phase 1)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_hypothesis_h1.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Pytest Suite",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "pytest",
                "-v"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Phase 2 Final Test Pipeline",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/task011_final_test.py",
                "run",
                "--root",
                ".",
                "--allow-final-test"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
