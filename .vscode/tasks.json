{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Unified Benchmark (Phase 1 + 2 + 3)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_hypothesis_h3.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Hypothesis H2 Evaluation (Phase 2)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_hypothesis_h2.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Hypothesis H1 Evaluation (Phase 1)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_hypothesis_h1.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Full Pytest Suite",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "pytest",
                "-v"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
