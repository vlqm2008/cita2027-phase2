{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run All Research Benchmarks & Tests (End-to-End)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_all_phases.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Open Live Adaptation Visualizer (Dashboard)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Start-Process",
                "'${workspaceFolder}/artifacts/adaptation/visualization/live_adaptation_visualizer.html'"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Phase 1: Hypothesis H1 Evaluation (Cross-Horizon Transfer)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_hypothesis_h1.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Phase 2: Hypothesis H2 Evaluation (Stale Feedback & Age Decay)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_hypothesis_h2.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Phase 3: Hypothesis H3 Evaluation (Unified Cross-Horizon Benchmark)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_hypothesis_h3.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Phase 4: Real-World Time Series Benchmark (SPY & BTCUSDT)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_real_data_adaptation.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Phase 5: Paired Statistical Significance Tests",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/run_statistical_tests.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Phase 6: Generate Publication Figures (300 DPI)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/plot_paper_figures.py"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Phase 7: Run Pytest Unit Test Suite",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "pytest",
                "tests/test_adaptation_h1.py",
                "tests/test_adaptation_h2.py",
                "tests/test_adaptation_h3.py",
                "tests/test_real_data_benchmark.py",
                "tests/test_significance.py",
                "-v"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/scripts"
                }
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
